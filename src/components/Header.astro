---
import { site } from '../data/site';

const home = Astro.url.pathname === '/';
// On the home page the nav scrolls; on any other page it goes back home first.
const prefix = home ? '' : '/';
const sections = [
  ['work', 'Work'],
  ['workflows', 'Workflows'],
  ['experience', 'Experience'],
  ['contact', 'Contact'],
] as const;
---

<header class="top">
  <div class="name">{home ? site.name : <a href="/">{site.name}</a>}</div>
  <nav aria-label="Sections">
    {sections.map(([id, label]) => <a href={`${prefix}#${id}`}>{label}</a>)}
  </nav>
</header>
